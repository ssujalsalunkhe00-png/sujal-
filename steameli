# calculator.py

def add(a, b):
    return a + b

def sub(a, b):
    return a - b

def mul(a, b):
    return a * b

def div(a, b):
    try:
        return a / b
    except ZeroDivisionError:
        return "Error: Division by zero"

def percent(a, b):
    return (a / 100) * b   # a% of b

def power(a, b):
    return a ** b

print("----- SIMPLE PYTHON CALCULATOR -----")

a = float(input("Enter first number: "))
b = float(input("Enter second number: "))

print("\n1. Add")
print("2. Subtract")
print("3. Multiply")
print("4. Divide")
print("5. Percent (a% of b)")
print("6. Power (a^b)\n")

choice = int(input("Choose operation (1–6): "))

if choice == 1:
    print("Result =", add(a, b))
elif choice == 2:
    print("Result =", sub(a, b))
elif choice == 3:
    print("Result =", mul(a, b))
elif choice == 4:
    print("Result =", div(a, b))
elif choice == 5:
    print("Result =", percent(a, b))
elif choice == 6:
    print("Result =", power(a, b))
else:
    print("Invalid choice")
